# ---------------------------------------------------------------
# VRIOSCU website configuration. Copy to .env and fill in values.
# Never commit .env. Every value here is a placeholder.
# ---------------------------------------------------------------

# development | test | production
APP_ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public origin of the site (https required in production)
BASE_URL=http://127.0.0.1:5000

# SQLite database file. Must be OUTSIDE any web-served directory.
# Production suggestion: /var/lib/vrioscu/vrioscu.db
DATABASE_PATH=instance/vrioscu.db

# Number of reverse proxies in front of the app (nginx = 1).
# Controls trust of X-Forwarded-For / X-Forwarded-Proto.
TRUSTED_PROXY_COUNT=0

# Sessions
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Login throttling
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: comma-separated origins allowed to call the PUBLIC release API
# (GET /api/v1/releases/*). Leave empty for same-origin only.
CORS_PUBLIC_ORIGINS=

# ---------------- Product configuration ----------------
PRODUCT_NAME=VRIOSCU
PRODUCT_VERSION=1.0.0
RELEASE_CHANNEL=PUBLIC_BETA
PUBLIC_BETA=true
# Confirm against real tested platforms before launch.
WINDOWS_COMPATIBILITY=Windows 10 and Windows 11 (64-bit)
# Set to true ONLY when the installer is actually Authenticode-signed.
INSTALLER_SIGNED=false

# Fallback download details, used when no published release exists
# in the database. Must be HTTPS. Leave empty until the file is hosted.
DOWNLOAD_URL=
RELEASE_NOTES_URL=
INSTALLER_FILENAME=
INSTALLER_SHA256=
INSTALLER_SIZE_BYTES=

# Optional comma-separated list of hosts allowed in download URLs,
# e.g. downloads.vrioscu.com. Empty = any HTTPS host.
DOWNLOAD_ALLOWED_HOSTS=

# Contacts. Leave empty until real mailboxes exist; the site will
# show the contact form instead of an address.
SUPPORT_EMAIL=
PRIVACY_EMAIL=
GENERAL_EMAIL=

# Privacy notice version recorded with account consent
PRIVACY_NOTICE_VERSION=2026-10-01
